# ------------------------------------------------------------------
# SutraKriti — example environment file for LOCAL development
# Copy this file to `.env` and adjust values as needed:
#   cp .env.example .env
# ------------------------------------------------------------------

# Public base URL of the site (used by CLI scripts / OG metadata)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# CORS allow-origin ("*" is fine for local dev)
CORS_ORIGINS=*

# ------------------------------------------------------------------
# MySQL / MariaDB
# ------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=sutrakriti
MYSQL_PASSWORD=sutrakriti_dev_pw
MYSQL_DATABASE=sutrakriti

# ------------------------------------------------------------------
# Razorpay (Buy Now stays disabled while these are blank)
# ------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_BUY_NOW_ENABLED=false

# ------------------------------------------------------------------
# SMTP  (leave blank to skip email; custom orders still land in DB)
# ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SutraKriti <sutrakriti.help@outlook.com>
ORDERS_EMAIL=sutrakriti.help@outlook.com

# ------------------------------------------------------------------
# Product image upload
# ------------------------------------------------------------------
UPLOAD_DIR=public/products
UPLOAD_TOKEN=sutrakriti-dev-upload-token

# ------------------------------------------------------------------
# Admin dashboard
# ------------------------------------------------------------------
ADMIN_PASSWORD=change-me-strong-password
ADMIN_SESSION_SECRET=change-me-random-long-string

# ------------------------------------------------------------------
# Brand
# ------------------------------------------------------------------
WHATSAPP_NUMBER=917777932385
BRAND_INSTAGRAM=https://www.instagram.com/_sutrakriti
BRAND_EMAIL=sutrakriti.help@outlook.com

# (Legacy placeholder — not used, safe to ignore)
MONGO_URL=mongodb://localhost:27017
DB_NAME=sutrakriti
